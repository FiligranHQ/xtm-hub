meta {
  name: CreateDeploymentRequest
  type: graphql
  seq: 3
}

post {
  url: {{baseUrl}}/graphql-api
  body: graphql
  auth: inherit
}

headers {
  cookie: {{cookie}}
}

body:graphql {
  mutation CreateDeploymentRequest($input: CreateDeploymentRequestInput!) {
    createDeploymentRequest(input: $input) {
      id
      platform_identifier
      region
      type
      hub_status
      ordering
      requester_email
      organization_requester_id
      service_instance_id
      organization_name
      request_date
      counts_in_orga_quota
    }
  }
}

body:graphql:vars {
  {
    "input": {
      "products": ["opencti"],
      "region": "eu_west",
      "type": "trial",
      "job_title": "ciso_cso_cio",
      "activity_sector": "computer_network_security",
      "use_case": "threat_hunting",
      "source": "xtmhub"
    }
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Ensure cookie is defined in environment

  input.products: list of PlatformIdentifier (opencti, openaev, xtmone)
    - type "trial": exactly one product, must not be xtmone
    - type "bundle": must include xtmone plus at least one other product
  input.region: DeploymentRequestPlatformRegion (eu_west, us_east, apac_au, apac_sg)
  input.type: DeploymentRequestDeploymentType (trial, bundle)
  input.source: DeploymentRequestSource (xtmhub, opencti_demo, openaev_demo)

  Example bundle request:
  "input": {
    "products": ["xtmone", "opencti", "openaev"],
    "region": "eu_west",
    "type": "bundle",
    "source": "xtmhub"
  }
}
