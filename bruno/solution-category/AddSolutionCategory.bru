meta {
  name: AddSolutionCategory
  type: graphql
  seq: 1
}

post {
  url: {{baseUrl}}/graphql-api
  body: graphql
  auth: inherit
}

headers {
  cookie: {{cookie}}
}

body:graphql {
  mutation AddSolutionCategory($input: AddSolutionCategoryInput!) {
    addSolutionCategory(input: $input) {
      id
      name
      product
    }
  }
}

body:graphql:vars {
  {
    "input": {
      "name": "{{solutionCategoryName}}",
      "product": ["opencti"]
    }
  }
}

docs {
  Ensure cookie is defined in environment.
  This request initializes test variables and stores solutionCategoryId for next steps.
}
