meta {
  name: PulseNetworkPlatforms
  type: graphql
  seq: 3
}

post {
  url: {{baseUrl}}/graphql-api
  body: graphql
  auth: inherit
}

body:graphql {
  query PulseNetworkPlatforms(
    $first: Int!
    $after: ID
    $orderBy: PulseNetworkPlatformOrdering!
    $orderMode: OrderingMode!
    $searchTerm: String
    $status: PulseNetworkPlatformStatus
  ) {
    pulseNetworkPlatforms(
      first: $first
      after: $after
      orderBy: $orderBy
      orderMode: $orderMode
      searchTerm: $searchTerm
      status: $status
    ) {
      totalCount
      pageInfo {
        hasNextPage
        endCursor
      }
      edges {
        node {
          id
          title
          organization_name
          sector_bucket
          region_bucket
          status
          first_contribution_day
          last_contribution_day
          last_batch_at
          batches_last_30_days
          records_last_30_days
          purge_requests
          last_purge_day
        }
      }
    }
  }
}

body:graphql:vars {
  {
    "first": 25,
    "orderBy": "records_last_30_days",
    "orderMode": "desc"
  }
}

docs {
  Hub administrators only (BYPASS capability): set the session cookie.
  `searchTerm` matches the platform title or its organization name; `status` is contributing, lapsed or preview_only.
}
