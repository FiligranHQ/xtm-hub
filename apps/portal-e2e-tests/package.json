{
  "name": "@xtm-hub/test_e2e",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "generate-test-e2e": "npx playwright codegen http://localhost:3002/",
    "test:e2e:update-snapshot": "playwright test --update-snapshots"
  },
  "dependencies": {
    "knex": "3.1.0",
    "pg": "8.20.0",
    "react": "19.2.4",
    "uuid": "11.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "24.12.0",
    "graphql": "16.13.1",
    "graphql-tag": "2.12.6",
    "monocart-reporter": "2.10.0",
    "playwright-ctrf-json-reporter": "0.0.28",
    "prettier": "3.8.1"
  },
  "packageManager": "yarn@4.12.0",
  "prettier": {
    "printWidth": 80,
    "semi": true,
    "bracketSameLine": true,
    "trailingComma": "es5",
    "tabWidth": 2,
    "singleQuote": true,
    "bracketSpacing": true,
    "arrowParens": "always",
    "singleAttributePerLine": true
  }
}
