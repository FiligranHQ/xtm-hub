{
  "name": "@xtm-hub/test_e2e",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "generate-test-e2e": "npx playwright codegen http://localhost:3002/",
    "test:e2e:update-snapshot": "playwright test --update-snapshots",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format:check": "prettier --check .",
    "prettier:format": "prettier --write ."
  },
  "dependencies": {
    "knex": "catalog:",
    "pg": "catalog:",
    "react": "catalog:",
    "uuid": "catalog:"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@playwright/test": "1.60.0",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "globals": "catalog:",
    "graphql": "catalog:",
    "graphql-tag": "2.12.6",
    "monocart-reporter": "catalog:",
    "playwright-ctrf-json-reporter": "0.0.29",
    "prettier": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "packageManager": "yarn@4.16.0+sha512.5374c94eb4ef6aa8188fb112f20c1aa6569f248d676c5e576e1fd2a1a4d8d87a96df65d9dfe1c2a0252cbe38bda46cf18d955005b81b43cc7607a5c9d56fd2b6",
  "prettier": {
    "printWidth": 80,
    "semi": true,
    "bracketSameLine": true,
