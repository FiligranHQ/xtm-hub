{
  "name": "@xtm-hub/test_e2e",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "generate-test-e2e": "npx playwright codegen http://localhost:3002/",
    "test:e2e:update-snapshot": "playwright test --update-snapshots",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format:check": "prettier --check .",
    "prettier:format": "prettier --write ."
  },
  "dependencies": {
    "knex": "catalog:",
    "pg": "catalog:",
    "react": "catalog:",
    "uuid": "catalog:"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@playwright/test": "1.60.0",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "globals": "catalog:",
    "graphql": "catalog:",
    "graphql-tag": "2.12.6",
    "monocart-reporter": "catalog:",
    "playwright-ctrf-json-reporter": "0.0.29",
    "prettier": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "packageManager": "yarn@4.17.0+sha512.c2957de2f9025ab14d63b24d0d8be1f1655810e22c341042c27f7ecd017b180ec12db73d69ac366d71b304ef9f069349ce462de96f04f8f1da317f4f762c95ae",
  "prettier": {
    "printWidth": 80,
    "semi": true,
    "bracketSameLine": true,
    "trailingComma": "es5",
