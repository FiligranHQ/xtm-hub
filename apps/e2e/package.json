    "react": "catalog:",
    "uuid": "catalog:"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@playwright/test": "1.62.0",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "globals": "catalog:",
    "graphql": "catalog:",
    "graphql-tag": "2.12.7",
    "monocart-reporter": "catalog:",
    "playwright-ctrf-json-reporter": "0.0.29",
    "prettier": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "packageManager": "yarn@4.17.1+sha512.ccbfabf7d7b6b32075088be9386fb9a2e00bb6887ef07fa56effabc890a56d53da1ccc4128d62db245fcbd3961b236d75335bdf7d5320ed6eafb7588b7ad4697",
  "prettier": {
