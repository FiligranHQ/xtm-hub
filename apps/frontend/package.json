{
  "name": "@xtm-hub/frontend",
  "version": "1.260605.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"relay-compiler && tsx scripts/generate-enum.ts\" \"yarn codegen:watch\" \"next dev  --turbopack -p 3002\"",
    "build": "relay-compiler && tsx scripts/generate-enum.ts && next build",
    "check-ts": "tsc --noEmit",
    "check-ts-test": "tsc --project tsconfig.test.json",
    "start": "next start -p 3002",
    "lint": "eslint .",
    "relay": "relay-compiler && tsx scripts/generate-enum.ts",
    "format:check": "prettier --check .",
    "format": "prettier . --write",
    "test": "vitest run",
    "test:w": "vitest",
    "test:ci": "yarn lint && yarn test --coverage --coverage.clean=false",
    "prepare": "cd .. && husky ./.husky",
    "auto-translation": "i18n-auto-translation -a deepl-free -p ./messages/en.json -t fr -k $SUBSCRIPTION_KEY && i18n-auto-translation -a deepl-free -p ./messages/en.json -t ja -k $SUBSCRIPTION_KEY",
    "generate:enum": "tsx scripts/generate-enum.ts",
    "generate:component": "tsx scripts/generate-component.ts",
    "extract-error-code-translation-key": "tsx scripts/extract-error-code-translation-keys.ts",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:watch": "graphql-codegen --config codegen.ts --watch",
    "i18n:check": "i18n-check --locales ./messages --source en"
  },
  "dependencies": {
    "@filigran/icon": "0.22.6",
    "@filigran/ui": "1.1.2",
    "@hookform/resolvers": "5.4.0",
    "@svgr/webpack": "8.1.0",
    "@tailwindcss/postcss": "4.3.0",
    "@tanstack/react-query": "5.100.14",
    "@uiw/react-md-editor": "4.1.1",
    "autoprefixer": "10.5.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "extract-files": "13.0.0",
    "graphql": "catalog:",
    "graphql-request": "6.1.0",
    "graphql-sse": "catalog:",
    "next": "16.2.7",
    "next-intl": "4.13.0",
    "next-themes": "0.4.6",
    "postcss": "8.5.15",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "7.77.0",
    "react-markdown": "10.1.0",
    "react-relay": "20.1.1",
    "remark-gfm": "4.0.1",
    "slugify": "1.6.9",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.0",
    "tsx": "catalog:",
    "tw-animate-css": "1.4.0",
    "usehooks-ts": "3.1.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "catalog:",
    "@graphql-codegen/typescript": "catalog:",
    "@graphql-codegen/typescript-operations": "4.6.1",
    "@graphql-codegen/typescript-react-query": "6.1.2",
    "@lingual/i18n-check": "0.9.5",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/react-hooks": "8.0.1",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "catalog:",
    "@types/react": "19.2.16",
    "@types/react-color": "3.0.13",
    "@types/react-dom": "19.2.3",
    "@types/react-relay": "18.2.1",
    "@types/relay-test-utils": "19.0.0",
    "@vitejs/plugin-react": "6.0.2",
    "@vitest/coverage-v8": "catalog:",
    "babel-plugin-relay": "20.1.1",
    "concurrently": "catalog:",
    "eslint": "catalog:",
    "eslint-config-next": "16.2.7",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-formatjs": "6.4.13",
    "graphql-codegen-typescript-mock-data": "5.1.1",
    "husky": "catalog:",
    "i18n-auto-translation": "2.2.3",
    "jsdom": "29.1.1",
    "lint-staged": "catalog:",
    "monocart-reporter": "catalog:",
    "msw": "2.14.6",
    "prettier": "catalog:",
    "prettier-plugin-organize-imports": "catalog:",
    "prettier-plugin-tailwindcss": "0.8.0",
    "rehype-sanitize": "6.0.0",
    "relay-compiler": "20.1.1",
    "relay-test-utils": "20.1.1",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-relay": "2.1.0",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "catalog:"
  },
  "tsConfig": "apps/frontend/tsconfig.json",
  "packageManager": "yarn@4.15.0+sha512.07ec708ac11e2eaa4ea2b04cfbb272812f7e74a753f1595eaef4486c663a98306a30cca3e6fc40f7a0b168dcfb3a2490b6a5e0501e20fb69cc36f563dd161c53",
  "prettier": {
    "printWidth": 80,
    "semi": true,
    "bracketSameLine": true,
    "trailingComma": "es5",
    "tabWidth": 2,
    "singleQuote": true,
    "bracketSpacing": true,
    "arrowParens": "always",
    "singleAttributePerLine": true,
    "plugins": [
      "prettier-plugin-tailwindcss",
      "prettier-plugin-organize-imports"
    ]
  }
}
