{
  "name": "@xtm-hub/portal-api",
  "version": "1.5.3",
  "description": "Portal API",
  "main": "src/index.js",
  "repository": "https://github.com/FiligranHQ/cloud-portal",
  "author": "Filigran",
  "license": "Filigran",
  "type": "module",
  "private": true,
  "scripts": {
    "copy": "cpy ./src/**/*.graphql dist/ && cpy ./src/migrations/*.js dist/",
    "check-ts": "tsc --noEmit",
    "generate:ts": "graphql-codegen-esm --config codegen.yml",
    "knex:run": "NODE_OPTIONS='--import tsx' knex --knexfile knexfile.ts",
    "migrate:make": "yarn knex:run migrate:make",
    "migrate:latest": "yarn knex:run migrate:latest",
    "migrate:up": "yarn knex:run migrate:up",
    "migrate:down": "yarn knex:run migrate:down",
    "esmigrate:run": "NODE_OPTIONS='--import tsx' node es-migrate.ts",
    "esmigrate:make": "migrate create --template-file ./src/thirdparty/elasticsearch/migration-template.js --migrations-dir src/es-migrations",
    "esmigrate:up": "yarn esmigrate:run up",
    "esmigrate:down": "yarn esmigrate:run down",
    "seed:make": "yarn knex:run seed:make",
    "generate-pg-to-ts": "NODE_OPTIONS='--import tsx' kanel",
    "build": "yarn copy && node builder/prod/prod.js",
    "start": "LOCAL_DEV=true node dist/index.js",
    "start-tsx": "LOCAL_DEV=true tsx --watch src/index.ts --clear-screen=false",
    "dev:tsc": "tsc --watch --preserveWatchOutput",
    "dev:node": "node --watch dist/index.js",
    "start-dev": "concurrently \"yarn dev:tsc\" \"yarn start-tsx\" \"yarn watch:graphql\"",
    "dev": "yarn start-dev",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "lint-staged": "lint-staged",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "VITEST_MODE=true && vitest run",
    "test:coverage": "yarn test --coverage",
    "test:ci": "yarn check-ts && yarn lint && yarn test --coverage --coverage.clean=false",
    "prepare": "cd .. && husky ./.husky",
    "seed:make:test": "VITEST_MODE=true && yarn knex:run seed:make",
    "start-dev-test": "VITEST_MODE=true && START_DEV_SERVER=true && yarn start-dev",
    "start-dev-e2e-test": "yarn clean-db-test && VITEST_MODE=true && START_DEV_SERVER=true && DATA_SEEDING=true && yarn start-dev",
    "test:w": "VITEST_MODE=true && vitest",
    "init-db-test": "VITEST_MODE=true tsx tests/script/create-database.ts",
    "clean-db-test": "VITEST_MODE=true tsx tests/script/clean-database.ts",
    "watch:graphql": "node builder/dev/watch-graphql.js"
  },
  "dependencies": {
    "@apollo/server": "5.4.0",
    "@as-integrations/express5": "1.1.2",
    "@aws-sdk/client-s3": "3.995.0",
    "@aws-sdk/lib-storage": "3.995.0",
    "@elastic/elasticsearch": "8.19.1",
    "@graphql-codegen/plugin-helpers": "5.1.1",
    "@graphql-tools/load-files": "7.0.1",
    "@graphql-tools/merge": "9.1.7",
    "@graphql-tools/schema": "10.0.31",
    "@graphql-tools/utils": "11.0.0",
    "apollo-errors": "1.9.0",
    "auth0": "4.37.0",
    "body-parser": "2.2.2",
    "config": "3.3.12",
    "cors": "2.8.6",
    "express": "5.2.1",
    "express-prom-bundle": "8.0.0",
    "express-rate-limit": "8.2.1",
    "express-session": "1.19.0",
    "glob": "11.1.0",
    "graphql": "16.13.0",
    "graphql-relay": "0.10.2",
    "graphql-sse": "2.6.0",
    "graphql-subscriptions": "2.0.0",
    "graphql-upload": "17.0.0",
    "handlebars": "4.7.8",
    "jwt-decode": "4.0.0",
    "knex": "3.1.0",
    "migrate": "^2.1.0",
    "node-cron": "4.2.1",
    "nodemailer": "7.0.11",
    "openid-client": "5.7.1",
    "passport": "0.7.0",
    "pg": "8.18.0",
    "pg-boss": "12.13.0",
    "prom-client": "15.1.3",
    "uuid": "13.0.0",
    "winston": "3.19.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.15",
    "@eslint/js": "9.39.3",
    "@graphql-codegen/cli": "5.0.7",
    "@graphql-codegen/typescript": "4.1.6",
    "@graphql-codegen/typescript-resolvers": "4.5.2",
    "@types/config": "3.3.5",
    "@types/cors": "2.8.19",
    "@types/express-session": "1.18.2",
    "@types/node": "24.10.13",
    "@types/nodemailer": "6.4.23",
    "@types/passport": "1.0.17",
    "@typescript-eslint/eslint-plugin": "8.56.1",
    "@typescript-eslint/parser": "8.56.1",
    "@vitest/coverage-v8": "3.2.4",
    "chokidar": "3.6.0",
    "concurrently": "9.2.1",
    "cpy-cli": "6.0.0",
    "esbuild": "0.27.3",
    "eslint": "9.x",
    "eslint-config-prettier": "10.1.8",
    "globals": "15.15.0",
    "husky": "9.1.7",
    "kanel": "3.16.1",
    "lint-staged": "15.5.2",
    "prettier": "3.8.1",
    "prettier-plugin-organize-imports": "4.3.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.56.1",
    "vitest": "3.2.4"
  },
  "packageManager": "yarn@4.12.0",
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,json}": [
      "yarn format",
      "yarn lint:fix"
    ]
  }
}
