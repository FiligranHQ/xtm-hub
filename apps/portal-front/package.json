{
  "name": "@xtm-hub/portal-front",
  "version": "1.21.7",
  "private": true,
  "scripts": {
    "dev": "concurrently \"relay-compiler && tsx scripts/generate-enum.ts\" \"next dev  --turbopack -p 3002\"",
    "build": "relay-compiler && tsx scripts/generate-enum.ts && next build",
    "check-ts": "tsc --noEmit",
    "check-ts-test": "tsc --project tsconfig.test.json",
    "start": "next start -p 3002",
    "lint": "eslint .",
    "relay": "relay-compiler && tsx scripts/generate-enum.ts",
    "format": "prettier . --write",
    "test": "vitest run",
    "test:w": "vitest",
    "test:ci": "yarn lint && yarn test --coverage --coverage.clean=false",
    "prepare": "cd .. && husky ./.husky",
    "auto-translation": "i18n-auto-translation -a deepl-free -p ./messages/en.json -t fr -k $SUBSCRIPTION_KEY",
    "generate:enum": "tsx scripts/generate-enum.ts",
    "extract-error-code-translation-key": "tsx scripts/extract-error-code-translation-keys.ts"
  },
  "dependencies": {
    "@filigran/icon": "0.22.4",
    "@filigran/ui": "0.46.0",
    "@hookform/resolvers": "5.2.2",
    "@svgr/webpack": "8.1.0",
    "@uiw/react-md-editor": "4.0.11",
    "autoprefixer": "10.4.27",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "extract-files": "13.0.0",
    "graphql": "16.13.1",
    "graphql-sse": "2.6.0",
    "next": "16.1.7",
    "next-intl": "4.8.3",
    "next-themes": "0.4.6",
    "postcss": "8.5.8",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "7.71.2",
    "react-markdown": "10.1.0",
    "react-relay": "20.1.1",
    "slugify": "1.6.8",
    "tailwind-merge": "3.5.0",
    "tailwindcss": "3.4.19",
    "tailwindcss-animate": "1.0.7",
    "tsx": "4.21.0",
    "usehooks-ts": "3.1.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/react-hooks": "8.0.1",
    "@testing-library/user-event": "14.6.1",
    "@types/config": "3.3.5",
    "@types/node": "24.12.0",
    "@types/react": "19.2.14",
    "@types/react-color": "3.0.13",
    "@types/react-dom": "19.2.3",
    "@types/react-relay": "18.2.1",
    "@types/relay-test-utils": "19.0.0",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "3.2.4",
    "babel-plugin-relay": "20.1.1",
    "concurrently": "9.2.1",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.1",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "i18n-auto-translation": "2.2.3",
    "jsdom": "27.4.0",
    "lint-staged": "16.4.0",
    "monocart-reporter": "2.10.0",
    "prettier": "3.8.1",
    "prettier-plugin-organize-imports": "4.3.0",
    "prettier-plugin-tailwindcss": "0.7.2",
    "rehype-sanitize": "6.0.0",
    "relay-compiler": "20.1.1",
    "relay-test-utils": "20.1.1",
    "typescript": "5.9.3",
    "vite-plugin-relay": "2.1.0",
    "vite-tsconfig-paths": "4.3.2",
    "vitest": "3.2.4"
  },
  "tsConfig": "apps/portal-front/tsconfig.json",
  "packageManager": "yarn@4.12.0",
  "prettier": {
    "printWidth": 80,
    "semi": true,
    "bracketSameLine": true,
    "trailingComma": "es5",
    "tabWidth": 2,
    "singleQuote": true,
    "bracketSpacing": true,
    "arrowParens": "always",
    "singleAttributePerLine": true,
    "plugins": [
      "prettier-plugin-tailwindcss",
      "prettier-plugin-organize-imports"
    ]
  }
}
